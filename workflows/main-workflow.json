      "parameters": {
        "jsCode": "const l=$json.lead; let reason=null,status='rejected',http=422; if($json.content_length>32768){reason='M_BODY_TOO_LARGE';http=413;} else if($json.malformed){reason='M_MALFORMED_OR_NON_OBJECT';http=400;} else if(!$json.content_type.toLowerCase().startsWith('application/json')){reason='M_WRONG_CONTENT_TYPE';http=400;} else if(!['website_form','meta_ad','google_ad','phone_intake'].includes(l.source))reason='V_INVALID_SOURCE'; else if(typeof l.lead_id==='string'&&!/^[A-Za-z0-9_-]{6,64}$/.test(l.lead_id))reason='V_INVALID_LEAD_ID'; else if(!l.first_name||typeof l.first_name!=='string'||l.first_name.length>50||!l.last_name||typeof l.last_name!=='string'||l.last_name.length>50)reason='V_MISSING_NAME'; else if(!l.email&&!l.phone)reason='V_MISSING_CONTACT'; else if(l.email&&!/^[^@\\s]+@[^@\\s]+\\.[A-Za-z]{2,}$/.test(l.email))reason='V_INVALID_EMAIL'; else if(l.phone&&(()=>{const d=String(l.phone).replace(/\\D/g,'');return d.length<10||d.length>15})())reason='V_INVALID_PHONE'; else if(!['HVAC','Plumbing','General Maintenance'].includes(l.service_requested))reason='V_UNSUPPORTED_SERVICE'; else if(!/^\\d{5}$/.test(String(l.postal_code||'')))reason='V_INVALID_POSTAL'; else if(Number(l.postal_code)<78701||Number(l.postal_code)>78759){reason='V_OUT_OF_COVERAGE';status='quarantined';} else if(l.message&&(typeof l.message!=='string'||l.message.length>1000))reason='V_INVALID_MESSAGE'; else if(l.consent_to_contact!==true)reason='V_CONSENT_REQUIRED'; else if(l.created_at&&(!Number.isFinite(Date.parse(l.created_at))||Date.parse(l.created_at)>Date.now()+86400000))reason='V_INVALID_CREATED_AT'; return [{json:{...$json,valid:!reason,rejection:{reason,status,http}}}];"
      }
