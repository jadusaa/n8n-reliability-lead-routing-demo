      "parameters": {
        "jsCode": "const crypto=require('crypto'); const headers=$json.headers||{}; const raw=$json.body; const allowed=['lead_id','source','created_at','first_name','last_name','email','phone','service_requested','postal_code','message','consent_to_contact']; let malformed=!raw||typeof raw!=='object'||Array.isArray(raw); let lead={},unknown=[]; if(!malformed){for(const [k,v] of Object.entries(raw)){if(!allowed.includes(k)){unknown.push(k);continue;}lead[k]=typeof v==='string'?(v.trim()||null):v;} if(typeof lead.source==='string')lead.source=lead.source.toLowerCase(); if(typeof lead.email==='string')lead.email=lead.email.toLowerCase(); if(typeof lead.phone==='string'){const supplied=lead.phone;lead.phone=supplied.replace(/[^0-9+]/g,'')||(supplied?'INVALID':null);} if(typeof lead.service_requested==='string'){const s={'hvac':'HVAC','plumbing':'Plumbing','general maintenance':'General Maintenance'};lead.service_requested=s[lead.service_requested.toLowerCase()]||lead.service_requested;}} const sha=v=>'sha256:'+crypto.createHash('sha256').update(String(v)).digest('hex'); return [{json:{headers,raw,lead,unknown,malformed,content_type:String(headers['content-type']||''),content_length:Number(headers['content-length']||0),execution_id:String($execution.id),raw_sha:sha(typeof raw==='string'?raw:JSON.stringify(raw))}}];"
