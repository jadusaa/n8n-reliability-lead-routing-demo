      "parameters": {
        "jsCode": "const req=$('Normalize Replay Request').item.json;const status=Number($json.statusCode||0),b=$json.body||{};if(status!==200)return [{json:{eligible:false,statusCode:422,body:{status:'replay_rejected',reason:req.failure_id?'R_FAILURE_NOT_FOUND':'R_STATE_NOT_FOUND'},retryAfter:null}}];if(!req.failure_id){if(b.processing_state==='completed')return [{json:{eligible:false,statusCode:200,body:{status:'replay_noop_completed',idempotency_key:req.idempotency_key},retryAfter:null}}];return [{json:{eligible:false,statusCode:422,body:{status:'replay_rejected',reason:'R_FAILURE_ID_REQUIRED'},retryAfter:null}}];}if(b.status==='failed_permanent'&&!req.corrected)return [{json:{eligible:false,statusCode:422,body:{status:'replay_blocked',reason:'R_PERMANENT_REQUIRES_CORRECTION',failure_id:req.failure_id},retryAfter:null,failure_id:req.failure_id,mark_blocked:true}}];const lead=JSON.parse(b.canonical_payload_json);const crypto=require('crypto'),sha=v=>'sha256:'+crypto.createHash('sha256').update(v).digest('hex'),canonical=v=>JSON.stringify(v,Object.keys(v).sort());const team=lead.service_requested==='Plumbing'?'Team B — Water':'Team A — Climate',priority=/urgent|emergency|no heat|no water|flood|leak|burst/i.test(lead.message||'')?'urgent':'normal';return [{json:{eligible:true,failure_id:req.failure_id,key:b.idempotency_key,lead,team,priority,payload_sha:sha(canonical(lead)),masked_summary:`${lead.first_name[0]}.${lead.last_name[0]}.|${lead.service_requested}|${lead.postal_code}|${team}|${priority}`,execution_id:req.execution_id,trace:{state_transitions:[],retries:{},reconciled:[]}}}];"
